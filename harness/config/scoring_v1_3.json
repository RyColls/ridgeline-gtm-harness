{
  "version": "1.3",
  "released": "2026-10-12",
  "owner": "RevOps (Ridgeline)",
  "changelog": [
    "Content downloads cut from +20 to +6 intent: a download alone no longer makes an SDR lead (SDR feedback: 41% of v1.2 Tier B leads were content-only and marked 'wrong').",
    "New hiring signal: open dispatcher / driver-manager job posts add up to +28 intent, decaying with a 30-day half-life.",
    "All intent signals now decay. Funding news uses a 90-day half-life, pricing visits 7 days.",
    "Persona: Director of Dispatch / VP Operations raised from +8 to +12 fit. They sign; IT rarely does.",
    "Missing fields now score 0 and are flagged 'unknown' instead of counting against the lead.",
    "Tier A from account-level intent now needs a buying persona (+10 or more). An analyst downloading a guide at a hot account goes to the account owner as Tier B, not a new Tier A."
  ],
  "fit": {
    "cap": 100,
    "segment": {
      "field": "company.segment",
      "points": {
        "3pl": 30,
        "carrier": 26,
        "broker": 12,
        "shipper": 0
      },
      "label": "Segment",
      "disqualify": [
        "shipper"
      ]
    },
    "employees": {
      "field": "company.employees",
      "bands": [
        [
          50,
          1000,
          18
        ],
        [
          20,
          49,
          6
        ]
      ],
      "label": "Company size"
    },
    "fleet": {
      "field": "company.fleet_size",
      "bands": [
        [
          50,
          500,
          22
        ],
        [
          501,
          5000,
          15
        ],
        [
          15,
          49,
          10
        ]
      ],
      "label": "Fleet (power units)"
    },
    "tech": {
      "field": "company.tech_stack",
      "points": {
        "legacy_tms": 18,
        "spreadsheets": 16,
        "competitor": 4,
        "modern_tms": 2
      },
      "label": "Current tooling"
    },
    "persona": {
      "field": "contact.persona",
      "points": {
        "dispatch_leader": 12,
        "ops_exec": 12,
        "c_level": 10,
        "it": 4,
        "individual": 0
      },
      "label": "Persona"
    },
    "geo": {
      "field": "company.country",
      "allowed": [
        "US",
        "CA"
      ],
      "points": 0,
      "label": "Geography"
    }
  },
  "intent": {
    "cap": 100,
    "demo_request": {
      "points": 35,
      "half_life_days": 14,
      "label": "Demo request"
    },
    "pricing_visits": {
      "points_per_visit": 8,
      "max": 24,
      "half_life_days": 7,
      "label": "Pricing page"
    },
    "content_download": {
      "points": 6,
      "half_life_days": 14,
      "label": "Content download"
    },
    "hiring": {
      "points_per_post": 14,
      "max": 28,
      "half_life_days": 30,
      "label": "Hiring dispatchers"
    },
    "funding": {
      "points": 12,
      "half_life_days": 90,
      "label": "Funding news"
    },
    "target_account": {
      "points": 10,
      "label": "Named target account"
    }
  },
  "tiers": [
    {
      "tier": "A",
      "min_fit": 70,
      "min_intent": 45,
      "sla_minutes": 15,
      "desc": "fit ≥ 70, intent ≥ 45 and a buying persona",
      "min_persona_points": 10
    },
    {
      "tier": "A",
      "min_fit": 60,
      "requires": "demo_request",
      "sla_minutes": 15,
      "desc": "fit ≥ 60 and asked for a demo"
    },
    {
      "tier": "B",
      "min_fit": 55,
      "min_intent": 20,
      "sla_minutes": 60,
      "desc": "fit ≥ 55 and intent ≥ 20"
    },
    {
      "tier": "C",
      "min_fit": 40,
      "sla_minutes": null,
      "desc": "fit ≥ 40"
    },
    {
      "tier": "Nurture",
      "sla_minutes": null,
      "desc": "everything else"
    }
  ]
}