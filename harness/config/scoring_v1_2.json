{
  "version": "1.2",
  "released": "2026-08-30",
  "owner": "RevOps (Ridgeline)",
  "changelog": [
    "First rules-based model replacing the vendor black-box score.",
    "Every content download adds +20 intent (Marketing request)."
  ],
  "fit": {
    "cap": 100,
    "segment": {
      "field": "company.segment",
      "points": {
        "3pl": 30,
        "carrier": 26,
        "broker": 12,
        "shipper": 0
      },
      "label": "Segment",
      "disqualify": [
        "shipper"
      ]
    },
    "employees": {
      "field": "company.employees",
      "bands": [
        [
          50,
          1000,
          18
        ],
        [
          20,
          49,
          6
        ]
      ],
      "label": "Company size"
    },
    "fleet": {
      "field": "company.fleet_size",
      "bands": [
        [
          50,
          500,
          22
        ],
        [
          501,
          5000,
          15
        ],
        [
          15,
          49,
          10
        ]
      ],
      "label": "Fleet (power units)"
    },
    "tech": {
      "field": "company.tech_stack",
      "points": {
        "legacy_tms": 18,
        "spreadsheets": 16,
        "competitor": 4,
        "modern_tms": 2
      },
      "label": "Current tooling"
    },
    "persona": {
      "field": "contact.persona",
      "points": {
        "dispatch_leader": 8,
        "ops_exec": 8,
        "c_level": 10,
        "it": 8,
        "individual": 0
      },
      "label": "Persona"
    },
    "geo": {
      "field": "company.country",
      "allowed": [
        "US",
        "CA"
      ],
      "points": 0,
      "label": "Geography"
    }
  },
  "intent": {
    "cap": 100,
    "demo_request": {
      "points": 35,
      "half_life_days": null,
      "label": "Demo request"
    },
    "pricing_visits": {
      "points_per_visit": 8,
      "max": 24,
      "half_life_days": null,
      "label": "Pricing page"
    },
    "content_download": {
      "points": 20,
      "half_life_days": null,
      "label": "Content download"
    },
    "hiring": null,
    "funding": {
      "points": 12,
      "half_life_days": null,
      "label": "Funding news"
    },
    "target_account": {
      "points": 10,
      "label": "Named target account"
    }
  },
  "tiers": [
    {
      "tier": "A",
      "min_fit": 70,
      "min_intent": 45,
      "sla_minutes": 15,
      "desc": "fit ≥ 70 and intent ≥ 45"
    },
    {
      "tier": "A",
      "min_fit": 60,
      "requires": "demo_request",
      "sla_minutes": 15,
      "desc": "fit ≥ 60 and asked for a demo"
    },
    {
      "tier": "B",
      "min_fit": 55,
      "min_intent": 20,
      "sla_minutes": 60,
      "desc": "fit ≥ 55 and intent ≥ 20"
    },
    {
      "tier": "C",
      "min_fit": 40,
      "sla_minutes": null,
      "desc": "fit ≥ 40"
    },
    {
      "tier": "Nurture",
      "sla_minutes": null,
      "desc": "everything else"
    }
  ]
}